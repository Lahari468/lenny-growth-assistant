# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# LLM Configuration
# Options: 'ollama' or 'anthropic'
LLM_PROVIDER=ollama

# Ollama Settings (Local LLM)
# Local workstation: http://localhost:11434
# Docker Compose: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3-local

# Anthropic Settings (Cloud LLM - Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database Configuration
# PostgreSQL with pgvector (Primary)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
# Synchronous DB URL for Alembic/scripts
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth
# Auto-fallback to local SQLite if PostgreSQL is unreachable
FALLBACK_TO_SQLITE=true
SQLITE_DB_PATH=./data/lenny_growth.db

# Embeddings Configuration
# Options: 'sentence-transformers', 'ollama', or 'lightweight'
EMBEDDING_PROVIDER=lightweight
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# CORS & Security
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
MAX_CHUNK_TOKENS=750
CHUNK_OVERLAP_TOKENS=100
