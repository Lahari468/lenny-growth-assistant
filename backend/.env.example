# Copy this file to .env and adjust values for your local setup.

APP_NAME="Lenny Growth Assistant"
ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string (SQLAlchemy + psycopg3 driver).
# Requires the pgvector extension available in the target Postgres instance.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth_assistant

# Separate database used only by the test suite (tests create/drop tables
# and never touch DATABASE_URL). Also requires the pgvector extension.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth_assistant_test

# Comma-separated list of allowed origins for local frontend development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# RAG / embeddings (Ollama). Used for embeddings regardless of chat provider.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Chat generation model (Ollama). Distinct from the embedding model above.
OLLAMA_CHAT_MODEL=phi3:latest

# Optional Pi Coding Agent orchestration. PI_MODEL must name a model that
# supports Pi's tool requirements; phi3:latest is known not to work for Pi.
PI_ENABLED=true
PI_COMMAND=pi
PI_PROVIDER=
PI_MODEL=
PI_TIMEOUT_SECONDS=60

# Transcript corpus location, relative to the project root
TRANSCRIPTS_DIR=data/transcripts
